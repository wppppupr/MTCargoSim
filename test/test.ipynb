   "source": [
    "using Plot\n",
    "\n",
    "function dna_force(f, r, r_out)\n",
    "    \"\"\"\n",
    "    # ステップ関数\n",
    "    if r < r_out\n",
    "        return -f\n",
    "    else\n",
    "        return 0.0\n",
    "    end\n",
    "    \"\"\"\n",
    "    # スムーズな関数\n",
    "    return - 2 * f .* r .* exp.(-r.^2)\n",
    "end\n",
    "\n",
    "\n",
    "#DNAの力のプロット\n",
    "r = 0:0.01:3.0\n",
    "f = 1.0\n",
    "r_out = 1.0\n",
    "forces = dna_force(f, r, r_out)"
   ]
